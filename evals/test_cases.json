    {
      "id": "eval_date_001",
      "description": "Test date parsing - ISO format",
      "date_formats": {
        "invoice_date": "2024-03-15"
      },
      "expected_parse": "2024-03-15"
    },
    {
      "id": "eval_date_002",
      "description": "Test date parsing - US format MM/DD/YYYY",
      "date_formats": {
        "invoice_date": "03/15/2024"
      },
      "expected_parse": "2024-03-15"
    },
    {
      "id": "eval_date_003",
      "description": "Test date parsing - Month Day, Year format",
      "date_formats": {
        "invoice_date": "March 15, 2024"
      },
      "expected_parse": "2024-03-15"
    },
    {
      "id": "eval_date_004",
      "description": "Test date parsing - European format DD/MM/YYYY",
      "date_formats": {
        "invoice_date": "15/03/2024"
      },
      "expected_parse": "2024-03-15"
    },
    {
      "id": "eval_math_001",
      "description": "Math consistency - exact match",
      "line_items": [
        {"description": "Item A", "quantity": 5, "unit_price": 10.00, "amount": 50.00}
      ],
      "subtotal": 50.00,
      "tax_rate": 0.08,
      "tax_amount": 4.00,
      "total_amount": 54.00,
      "should_pass_math": true
    },
    {
      "id": "eval_math_002",
      "description": "Math consistency - shipping included",
      "line_items": [
        {"description": "Item B", "quantity": 3, "unit_price": 100.00, "amount": 300.00}
      ],
      "subtotal": 300.00,
      "tax_rate": 0.08,
      "tax_amount": 24.00,
      "shipping_amount": 15.00,
      "total_amount": 339.00,
      "should_pass_math": true
    },
    {
      "id": "eval_math_003",
      "description": "Math consistency - discount applied",
      "line_items": [
        {"description": "Item C", "quantity": 2, "unit_price": 500.00, "amount": 1000.00}
      ],
      "subtotal": 1000.00,
      "tax_rate": 0.08,
      "tax_amount": 80.00,
      "discount_amount": 50.00,
      "total_amount": 1030.00,
      "should_pass_math": true
    },
    {
      "id": "eval_math_004",
      "description": "Math consistency - tax rate > 1 should be normalized",
      "line_items": [
        {"description": "Item D", "quantity": 1, "unit_price": 1000.00, "amount": 1000.00}
      ],
      "subtotal": 1000.00,
      "tax_rate": 8.0,
      "tax_amount": 80.00,
      "total_amount": 1080.00,
      "should_normalize_tax_rate": true,
      "should_pass_math": true
    },
    {
      "id": "eval_validation_001",
      "description": "Required field missing - vendor_name",
      "data": {
        "customer_name": "Test",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 100.00,
        "tax_rate": 0.08,
        "tax_amount": 8.00,
        "total_amount": 108.00,
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "should_fail": true,
      "expected_error_field": "vendor_name"
    },
    {
      "id": "eval_validation_002",
      "description": "Line item amount mismatch",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 110.00,
        "tax_rate": 0.08,
        "tax_amount": 8.80,
        "total_amount": 118.80,
        "line_items": [{"description": "Test", "quantity": 10, "unit_price": 10.00, "amount": 99.00}]
      },
      "should_fail": true,
      "expected_error_field": "line_items"
    },
    {
      "id": "eval_validation_003",
      "description": "Negative discount should be clamped to 0",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 100.00,
        "tax_rate": 0.08,
        "tax_amount": 8.00,
        "total_amount": 108.00,
        "discount_amount": -25.00,
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "should_clamp_discount": true,
      "expected_discount": 0.0
    },
    {
      "id": "eval_validation_004",
      "description": "Currency string parsing - $ symbol",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": "100.00",
        "tax_rate": 0.08,
        "tax_amount": "8.00",
        "total_amount": "108.00",
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "should_parse_strings": true
    },
    {
      "id": "eval_validation_005",
      "description": "Currency string parsing - with commas",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": "1,234.56",
        "tax_rate": 0.08,
        "tax_amount": "98.76",
        "total_amount": "1,333.32",
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 1234.56, "amount": 1234.56}]
      },
      "should_parse_strings": true
    },
    {
      "id": "eval_edge_001",
      "description": "Zero quantity should fail",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 0.00,
        "tax_rate": 0.08,
        "tax_amount": 0.00,
        "total_amount": 0.00,
        "line_items": [{"description": "Test", "quantity": 0, "unit_price": 100.00, "amount": 0.00}]
      },
      "should_fail": true,
      "expected_error_field": "line_items"
    },
    {
      "id": "eval_edge_002",
      "description": "Negative unit price should fail",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": -100.00,
        "tax_rate": 0.08,
        "tax_amount": -8.00,
        "total_amount": -108.00,
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": -100.00, "amount": -100.00}]
      },
      "should_fail": true,
      "expected_error_field": "line_items"
    },
    {
      "id": "eval_edge_003",
      "description": "Empty line items should fail",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 0.00,
        "tax_rate": 0.08,
        "tax_amount": 0.00,
        "total_amount": 0.00,
        "line_items": []
      },
      "should_fail": true,
      "expected_error_field": "line_items"
    },
    {
      "id": "eval_edge_004",
      "description": "Tax rate > 1 should fail without normalization",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 100.00,
        "tax_rate": 8.0,
        "tax_amount": 8.00,
        "total_amount": 108.00,
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "note": "With normalization (divide by 100), this should pass. Without, should fail."
    },
    {
      "id": "eval_edge_005",
      "description": "Very small tax rate",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 10000.00,
        "tax_rate": 0.0001,
        "tax_amount": 1.00,
        "total_amount": 10001.00,
        "line_items": [{"description": "Test", "quantity": 1, "unit_price": 10000.00, "amount": 10000.00}]
      },
      "should_pass": true
    },
    {
      "id": "eval_edge_006",
      "description": "Many line items (stress test)",
      "line_item_count": 50,
      "subtotal": 5000.00,
      "tax_rate": 0.08,
      "tax_amount": 400.00,
        "total_amount": 5400.00,
        "should_pass": true
    },
    {
      "id": "eval_edge_007",
      "description": "Unicode in vendor name",
      "data": {
        "vendor_name": "Café Möbel & Sons GmbH",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 100.00,
        "tax_rate": 0.08,
        "tax_amount": 8.00,
        "total_amount": 108.00,
        "line_items": [{"description": "Café Table", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "should_pass": true
    },
    {
      "id": "eval_edge_008",
      "description": "Special characters in description",
      "data": {
        "vendor_name": "Test Vendor",
        "customer_name": "Test Customer",
        "invoice_number": "INV001",
        "invoice_date": "2024-01-01",
        "subtotal": 299.99,
        "tax_rate": 0.08,
        "tax_amount": 24.00,
        "total_amount": 323.99,
        "line_items": [{"description": "Product #123-B (Special & Co.)", "quantity": 1, "unit_price": 299.99, "amount": 299.99}]
      },
      "should_pass": true
    },
    {
      "id": "eval_schema_001",
      "description": "All optional fields present",
      "include_all_optional": true,
      "should_pass": true
    },
    {
      "id": "eval_schema_002",
      "description": "No optional fields (minimal valid)",
      "include_all_optional": false,
      "minimal_required": {
        "vendor_name": "Minimal Corp",
        "customer_name": "Client",
        "invoice_number": "MIN001",
        "invoice_date": "2024-01-01",
        "subtotal": 100.00,
        "tax_rate": 0.08,
        "tax_amount": 8.00,
        "total_amount": 108.00,
        "line_items": [{"description": "Item", "quantity": 1, "unit_price": 100.00, "amount": 100.00}]
      },
      "should_pass": true
    }
  ]
